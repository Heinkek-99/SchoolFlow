<UserControl x:Class="SchoolFlow.Desktop.Views.FamillesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Liste des familles -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Gestion des Familles" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50" />
                <Button Content="+ Nouvelle famille" 
                        Command="{Binding AddFamilleCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- Barre de recherche -->
            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Padding="10"
                             FontSize="14" />
                    <Button Grid.Column="1" 
                            Content="Rechercher" 
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- Liste DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>
                <DataGrid ItemsSource="{Binding Familles}" 
                          SelectedItem="{Binding SelectedFamille}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom du père" Binding="{Binding NomPere}" Width="*" />
                        <DataGridTextColumn Header="Nom de la mère" Binding="{Binding NomMere}" Width="*" />
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="120" />
                        <DataGridTextColumn Header="Nb Enfants" Binding="{Binding NombreEnfants}" Width="80" />
                        <DataGridTextColumn Header="Solde" 
                                            Binding="{Binding SoldeGlobal, Converter={StaticResource CurrencyConverter}}" 
                                            Width="120" />
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👁" 
                                                ToolTip="Voir détail"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Content="✏" 
                                                ToolTip="Modifier"
                                                Command="{Binding DataContext.EditFamilleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Content="🗑" 
                                                ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteFamilleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Panneau de détail -->
        <Border Grid.Column="1" 
                Width="350" 
                Background="White" 
                CornerRadius="8" 
                Padding="20"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- En-tête détail -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Détail Famille" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50" />
                    <Button Content="✕" 
                            Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="50,0,0,0" />
                </StackPanel>

                <!-- Informations famille -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="{Binding FamilleDetail.NomPere}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50" />
                    <TextBlock Text="{Binding FamilleDetail.NomMere}" 
                               FontSize="14" 
                               Foreground="#7F8C8D"
                               Margin="0,5,0,0" />
                    <TextBlock Margin="0,10,0,0">
                        <Run Text="Tél: " Foreground="#7F8C8D" />
                        <Run Text="{Binding FamilleDetail.Telephone}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="Adresse: " Foreground="#7F8C8D" />
                        <Run Text="{Binding FamilleDetail.Adresse}" />
                    </TextBlock>

                    <!-- Solde -->
                    <Border Background="{Binding FamilleDetail.SoldeGlobal, Converter={StaticResource SoldeToColorConverter}}" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Solde global" Foreground="White" Opacity="0.8" FontSize="12" />
                            <TextBlock Text="{Binding SoldeFormatted}" 
                                       Foreground="White" 
                                       FontSize="24" 
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Liste des enfants -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Enfants" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#34495E"
                               Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding FamilleDetail.Enfants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" 
                                        CornerRadius="5" 
                                        Padding="10" 
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Prenom}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Nom}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Classe}" 
                                                       Foreground="#7F8C8D" 
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding Matricule}" 
                                                       Foreground="#95A5A6" 
                                                       FontSize="10" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding SoldeFrais, Converter={StaticResource CurrencyConverter}}"
                                                   Foreground="{Binding SoldeFrais, Converter={StaticResource SoldeToColorConverter}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <Button Content="+ Ajouter un enfant" 
                            Command="{Binding AddEnfantCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Indicateur de chargement -->
        <Border Grid.ColumnSpan="2" 
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
