<UserControl x:Class="SchoolFlow.Desktop.Views.EleveFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Button Content="←" 
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    FontSize="20"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding PageTitle}" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center" />
            <!-- Matricule si en mode édition -->
            <Border Background="#3498DB" 
                    CornerRadius="5" 
                    Padding="10,5" 
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Matricule, StringFormat=Matricule: {0}}" 
                           Foreground="White" 
                           FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="30"
                    MaxWidth="900"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>

                <StackPanel>
                    <!-- Section Identité -->
                    <TextBlock Text="Identité de l'élève" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nom -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Nom *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                            <TextBlock Text="{Binding NomError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,10"
                                       Visibility="{Binding NomError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Prénom -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="Prénom *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                            <TextBlock Text="{Binding PrenomError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,10"
                                       Visibility="{Binding PrenomError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Sexe -->
                        <StackPanel Grid.Column="4" Grid.Row="0">
                            <TextBlock Text="Sexe *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Sexes}"
                                      SelectedItem="{Binding SelectedSexe}"
                                      DisplayMemberPath="Libelle"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      Height="44" />
                        </StackPanel>

                        <!-- Date de naissance -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="Date de naissance *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <DatePicker SelectedDate="{Binding DateNaissance}"
                                        Style="{StaticResource InputDatePickerStyle}"
                                        Height="44" />
                            <TextBlock Text="{Binding DateNaissanceError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding DateNaissanceError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Lieu de naissance -->
                        <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="Lieu de naissance" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding LieuNaissance, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>

                        <!-- Nationalité -->
                        <StackPanel Grid.Column="4" Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="Nationalité" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Nationalite, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,25" Background="#ECF0F1" />

                    <!-- Section Affectation -->
                    <TextBlock Text="Affectation scolaire" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Famille -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Famille *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Familles}"
                                      SelectedItem="{Binding SelectedFamille}"
                                      DisplayMemberPath="NomComplet"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      Height="44" />
                            <TextBlock Text="{Binding FamilleError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding FamilleError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Classe -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Classe *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Classes}"
                                      SelectedItem="{Binding SelectedClasse}"
                                      DisplayMemberPath="Nom"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      Height="44" />
                            <TextBlock Text="{Binding ClasseError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding ClasseError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Options -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <CheckBox Content="Boursier" 
                                  IsChecked="{Binding EstBoursier}"
                                  Margin="0,0,30,0"
                                  VerticalContentAlignment="Center" />
                        <CheckBox Content="Redoublant" 
                                  IsChecked="{Binding EstRedoublant}"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Separator Margin="0,25" Background="#ECF0F1" />

                    <!-- Section Informations complémentaires -->
                    <TextBlock Text="Informations complémentaires" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Allergies -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Allergies / Problèmes de santé" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <!-- Observations -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Observations" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Observations, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Boutons d'action -->
        <Border Grid.Row="2" 
                Background="White" 
                Padding="20" 
                Margin="-30,-1,-30,-30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="-2" Opacity="0.1" Direction="90" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,15,0" />
                <Button Content="Enregistrer" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="150" />
            </StackPanel>
        </Border>

        <!-- Indicateur de chargement -->
        <Border Grid.RowSpan="3" 
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                <TextBlock Text="Traitement en cours..." 
                           Foreground="White" 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
