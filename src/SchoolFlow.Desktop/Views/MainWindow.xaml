<Window x:Class="SchoolFlow.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SchoolFlow.Desktop.Views"
        xmlns:vm="clr-namespace:SchoolFlow.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Titre}" 
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- DataTemplates pour le ContentControl -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FamillesViewModel}">
            <views:FamillesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ElevesViewModel}">
            <views:ElevesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaiementsViewModel}">
            <views:PaiementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClassesViewModel}">
            <views:ClassesView />
        </DataTemplate>
        <!-- Formulaires CRUD -->
        <DataTemplate DataType="{x:Type vm:FamilleFormViewModel}">
            <views:FamilleFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EleveFormViewModel}">
            <views:EleveFormView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Grid.Column="0" 
                Background="#2C3E50" 
                Width="250"
                Visibility="{Binding IsMenuVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- En-tête avec logo -->
                <StackPanel Grid.Row="0" Margin="20">
                    <TextBlock Text="SchoolFlow" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Gestion Scolaire" 
                               FontSize="12" 
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center" />
                    <Separator Margin="0,15,0,10" Background="#34495E" />
                </StackPanel>

                <!-- Menu de navigation -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <Button Content="📊 Tableau de bord" 
                            Command="{Binding NavigateToDashboardCommand}"
                            Style="{StaticResource MenuButtonStyle}" />
                    <Button Content="👨‍👩‍👧‍👦 Familles" 
                            Command="{Binding NavigateToFamillesCommand}"
                            Style="{StaticResource MenuButtonStyle}" />
                    <Button Content="🎓 Élèves" 
                            Command="{Binding NavigateToElevesCommand}"
                            Style="{StaticResource MenuButtonStyle}" />
                    <Button Content="💰 Paiements" 
                            Command="{Binding NavigateToPaiementsCommand}"
                            Style="{StaticResource MenuButtonStyle}" />
                    <Button Content="🏫 Classes" 
                            Command="{Binding NavigateToClassesCommand}"
                            Style="{StaticResource MenuButtonStyle}" />
                </StackPanel>

                <!-- Informations utilisateur et déconnexion -->
                <StackPanel Grid.Row="2" Margin="15">
                    <Separator Margin="0,0,0,10" Background="#34495E" />
                    <TextBlock Text="{Binding UserName}" 
                               Foreground="White" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding UserRole}" 
                               Foreground="#95A5A6" 
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,10" />
                    <Button Content="🚪 Déconnexion" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="#C0392B" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentViewModel}"
                        Margin="0" />
    </Grid>
</Window>
