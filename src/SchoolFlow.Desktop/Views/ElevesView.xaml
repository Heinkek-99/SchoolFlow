<UserControl x:Class="SchoolFlow.Desktop.Views.ElevesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Liste des élèves -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Gestion des Élèves" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50" />
                <Button Content="+ Inscrire un élève" 
                        Command="{Binding AddEleveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- Filtres -->
            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Recherche -->
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Padding="10"
                             Margin="0,0,10,0" />
                    
                    <!-- Filtre par classe -->
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Classes}"
                              SelectedItem="{Binding SelectedClasse}"
                              DisplayMemberPath="Nom"
                              Style="{StaticResource FilterComboBoxStyle}"
                              Margin="0,0,10,0" />
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Rechercher" 
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,5,0" />
                        <Button Content="Filtrer" 
                                Command="{Binding FilterByClasseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid élèves -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>
                <DataGrid ItemsSource="{Binding Eleves}" 
                          SelectedItem="{Binding SelectedEleve}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="120" />
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*" />
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                        <DataGridTextColumn Header="Classe" Binding="{Binding Classe}" Width="120" />
                        <DataGridTextColumn Header="Date naissance" 
                                            Binding="{Binding DateNaissance, StringFormat={}{0:dd/MM/yyyy}}" 
                                            Width="100" />
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👁" 
                                                ToolTip="Voir dossier"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Content="👨‍👩‍👧" 
                                                ToolTip="Voir famille"
                                                Command="{Binding DataContext.ViewFamilleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Content="✏" 
                                                ToolTip="Modifier"
                                                Command="{Binding DataContext.EditEleveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Content="🗑" 
                                                ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteEleveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Panneau détail élève -->
        <Border Grid.Column="1" 
                Width="380" 
                Background="White" 
                CornerRadius="8" 
                Padding="20"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Dossier Élève" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50" />
                    <Button Content="✕" 
                            Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="80,0,0,0" />
                </StackPanel>

                <!-- Informations élève -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <!-- Photo placeholder -->
                    <Border Width="80" 
                            Height="80" 
                            CornerRadius="40" 
                            Background="#3498DB" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,15">
                        <TextBlock Text="{Binding EleveDossier.Initiales}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#2C3E50">
                        <Run Text="{Binding EleveDossier.Prenom}" />
                        <Run Text=" " />
                        <Run Text="{Binding EleveDossier.Nom}" />
                    </TextBlock>
                    <TextBlock Text="{Binding EleveDossier.Matricule}" 
                               Foreground="#7F8C8D" 
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                    <TextBlock Text="{Binding EleveDossier.Classe}" 
                               FontWeight="SemiBold" 
                               Foreground="#3498DB" 
                               HorizontalAlignment="Center"
                               Margin="0,5,0,15" />

                    <!-- Solde -->
                    <Border Background="{Binding EleveDossier.SoldeTotal, Converter={StaticResource SoldeToColorConverter}}" 
                            CornerRadius="5" 
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="Solde frais" Foreground="White" Opacity="0.8" FontSize="12" />
                            <TextBlock Text="{Binding SoldeEleveFormatted}" 
                                       Foreground="White" 
                                       FontSize="22" 
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Détail des frais -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Détail des frais" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding EleveDossier.Frais}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F9FA" 
                                            CornerRadius="5" 
                                            Padding="10" 
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TypeFrais}" FontWeight="SemiBold" />
                                                <TextBlock FontSize="11" Foreground="#7F8C8D">
                                                    <Run Text="Échéance: " />
                                                    <Run Text="{Binding Echeance, StringFormat={}{0:dd/MM/yyyy}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding MontantDu, Converter={StaticResource CurrencyConverter}}" 
                                                           FontSize="11" Foreground="#7F8C8D" />
                                                <TextBlock Text="{Binding Reste, Converter={StaticResource CurrencyConverter}}" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Reste, Converter={StaticResource SoldeToColorConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Chargement -->
        <Border Grid.ColumnSpan="2" 
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
