<UserControl x:Class="SchoolFlow.Desktop.Views.FamilleFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Button Content="←" 
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    FontSize="20"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding PageTitle}" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="30"
                    MaxWidth="800"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>

                <StackPanel>
                    <!-- Section Père -->
                    <TextBlock Text="Informations du Père" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nom du père -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Nom du père *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding NomPere, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                            <TextBlock Text="{Binding NomPereError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,10"
                                       Visibility="{Binding NomPereError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Prénom du père -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="Prénom du père" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding PrenomPere, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,20" Background="#ECF0F1" />

                    <!-- Section Mère -->
                    <TextBlock Text="Informations de la Mère" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Nom de la mère -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nom de la mère" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding NomMere, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>

                        <!-- Prénom de la mère -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Prénom de la mère" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding PrenomMere, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,20" Background="#ECF0F1" />

                    <!-- Section Contact -->
                    <TextBlock Text="Coordonnées" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Téléphone principal -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Téléphone principal *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                            <TextBlock Text="{Binding TelephoneError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,10"
                                       Visibility="{Binding TelephoneError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Téléphone secondaire -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="Téléphone secondaire" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding TelephoneSecondaire, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,15,0,0">
                            <TextBlock Text="Email" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                            <TextBlock Text="{Binding EmailError}" 
                                       Foreground="#E74C3C" 
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding EmailError, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,20" Background="#ECF0F1" />

                    <!-- Section Adresse -->
                    <TextBlock Text="Adresse" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Adresse -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Adresse complète" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>

                        <!-- Quartier -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quartier" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Quartier, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>

                        <!-- Ville -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Ville" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Padding="12" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Boutons d'action -->
        <Border Grid.Row="2" 
                Background="White" 
                Padding="20" 
                Margin="-30,-1,-30,-30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="-2" Opacity="0.1" Direction="90" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,15,0" />
                <Button Content="{Binding IsEditMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Mettre \u00e0 jour|Enregistrer}" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="150" />
            </StackPanel>
        </Border>

        <!-- Indicateur de chargement -->
        <Border Grid.RowSpan="3" 
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                <TextBlock Text="Enregistrement en cours..." 
                           Foreground="White" 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
