<UserControl x:Class="SchoolFlow.Desktop.Views.PaiementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Liste des paiements -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Gestion des Paiements" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50" />
                <Button Content="+ Nouveau paiement" 
                        Command="{Binding NouveauPaiementCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- DataGrid paiements -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>
                <DataGrid ItemsSource="{Binding Paiements}" 
                          SelectedItem="{Binding SelectedPaiement}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° Reçu" Binding="{Binding NumeroRecu}" Width="100" />
                        <DataGridTextColumn Header="Date" 
                                            Binding="{Binding DatePaiement, StringFormat={}{0:dd/MM/yyyy HH:mm}}" 
                                            Width="130" />
                        <DataGridTextColumn Header="Famille" Binding="{Binding NomFamille}" Width="*" />
                        <DataGridTextColumn Header="Montant" 
                                            Binding="{Binding Montant, Converter={StaticResource CurrencyConverter}}" 
                                            Width="120" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModePaiement}" Width="100" />
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👁" 
                                                ToolTip="Voir détail"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Content="🖨" 
                                                ToolTip="Imprimer reçu"
                                                Command="{Binding DataContext.ImprimerRecuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource IconButtonStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Panneau nouveau paiement / détail -->
        <Border Grid.Column="1" 
                Width="400" 
                Background="White" 
                CornerRadius="8" 
                Padding="20"
                Visibility="{Binding IsNouveauPaiementVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Nouveau Paiement" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50" />
                    <Button Content="✕" 
                            Command="{Binding AnnulerPaiementCommand}"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="80,0,0,0" />
                </StackPanel>

                <!-- Formulaire -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Sélection famille -->
                        <TextBlock Text="Famille *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Familles}"
                                  SelectedItem="{Binding SelectedFamille}"
                                  DisplayMemberPath="NomComplet"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  Margin="0,0,0,15" />

                        <!-- Montant -->
                        <TextBlock Text="Montant (FCFA) *" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                        <TextBox Text="{Binding MontantPaiement, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Padding="12"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Margin="0,0,0,15" />

                        <!-- Mode de paiement -->
                        <TextBlock Text="Mode de paiement" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding ModesPaiement}"
                                  SelectedItem="{Binding ModePaiement}"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  Margin="0,0,0,15" />

                        <!-- Référence -->
                        <TextBlock Text="Référence (optionnel)" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Padding="10"
                                 Margin="0,0,0,20" />

                        <!-- Section Ventilation -->
                        <Border Background="#F8F9FA" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Ventilation par enfant" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="#34495E" />
                                    <Button Content="Auto" 
                                            Command="{Binding VentilationAutomatiqueCommand}"
                                            Style="{StaticResource SmallButtonStyle}"
                                            Margin="10,0,0,0" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Ventilations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding NomEleve}" 
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" 
                                                         Text="{Binding Montant, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         Padding="8"
                                                         TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Reste à ventiler -->
                                <Border Background="{Binding VentilationValide, Converter={StaticResource BoolToColorConverter}}" 
                                        CornerRadius="3" 
                                        Padding="10" 
                                        Margin="0,10,0,0">
                                    <TextBlock HorizontalAlignment="Center">
                                        <Run Text="Reste à ventiler: " Foreground="White" />
                                        <Run Text="{Binding MontantRestantFormatted}" 
                                             Foreground="White" 
                                             FontWeight="Bold" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Boutons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Annuler" 
                            Command="{Binding AnnulerPaiementCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="Enregistrer" 
                            Command="{Binding EnregistrerPaiementCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panneau détail paiement -->
        <Border Grid.Column="1" 
                Width="400" 
                Background="White" 
                CornerRadius="8" 
                Padding="20"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Détail Paiement" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50" />
                    <Button Content="✕" 
                            Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="100,0,0,0" />
                </StackPanel>

                <!-- Contenu -->
                <StackPanel Grid.Row="1">
                    <Border Background="#27AE60" CornerRadius="5" Padding="20" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PaiementDetail.Montant, Converter={StaticResource CurrencyConverter}}" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PaiementDetail.DatePaiement, StringFormat=Le {0:dd/MM/yyyy} à {0:HH:mm}}" 
                                       Foreground="White" 
                                       Opacity="0.8"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,0,0,5">
                        <Run Text="Reçu N°: " Foreground="#7F8C8D" />
                        <Run Text="{Binding PaiementDetail.NumeroRecu}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,5">
                        <Run Text="Famille: " Foreground="#7F8C8D" />
                        <Run Text="{Binding PaiementDetail.NomFamille}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,5">
                        <Run Text="Mode: " Foreground="#7F8C8D" />
                        <Run Text="{Binding PaiementDetail.ModePaiement}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,15">
                        <Run Text="Référence: " Foreground="#7F8C8D" />
                        <Run Text="{Binding PaiementDetail.Reference}" />
                    </TextBlock>

                    <!-- Ventilation -->
                    <TextBlock Text="Répartition" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#34495E"
                               Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding PaiementDetail.Ventilations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NomEleve}" />
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Montant, Converter={StaticResource CurrencyConverter}}" 
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="🖨 Imprimer le reçu" 
                            Command="{Binding ImprimerRecuCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,20,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chargement -->
        <Border Grid.ColumnSpan="2" 
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
