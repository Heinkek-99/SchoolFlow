<UserControl x:Class="SchoolFlow.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <TextBlock Text="Tableau de bord" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50" />
            <Button Content="↻ Actualiser" 
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center" />
        </StackPanel>

        <!-- Cartes statistiques -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,30">
            <!-- Familles -->
            <Border Style="{StaticResource StatCardStyle}" Background="#3498DB" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Familles" FontSize="14" Foreground="White" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalFamilles}" 
                               FontSize="36" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    <Button Content="Voir les familles →" 
                            Command="{Binding NavigateToFamillesCommand}"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Élèves -->
            <Border Style="{StaticResource StatCardStyle}" Background="#27AE60" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Élèves inscrits" FontSize="14" Foreground="White" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalEleves}" 
                               FontSize="36" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    <Button Content="Voir les élèves →" 
                            Command="{Binding NavigateToElevesCommand}"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Recettes -->
            <Border Style="{StaticResource StatCardStyle}" Background="#9B59B6" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Total Recettes" FontSize="14" Foreground="White" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalRecettesFormatted}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    <Button Content="Voir les paiements →" 
                            Command="{Binding NavigateToPaiementsCommand}"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Impayés -->
            <Border Style="{StaticResource StatCardStyle}" Background="#E74C3C">
                <StackPanel>
                    <TextBlock Text="Total Impayés" FontSize="14" Foreground="White" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalImpayesFormatted}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="Taux recouvrement: " Foreground="White" Opacity="0.8" FontSize="11" />
                        <Run Text="{Binding TauxRecouvrement, StringFormat={}{0:F1}%}" 
                             Foreground="White" FontWeight="SemiBold" FontSize="11" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Contenu principal (graphiques, listes récentes) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Zone graphique / Résumé -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="8" 
                    Margin="0,0,15,0"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Résumé de l'année scolaire" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,20" />
                    
                    <!-- Placeholder pour graphique -->
                    <Border Background="#F8F9FA" 
                            Height="300" 
                            CornerRadius="5">
                        <TextBlock Text="Graphique des paiements par mois"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#95A5A6" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Accès rapides -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="8" 
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Actions rapides" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="0,0,0,20" />

                    <Button Content="+ Nouvelle famille"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Margin="0,0,0,10" />
                    <Button Content="+ Inscrire un élève"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Margin="0,0,0,10" />
                    <Button Content="+ Enregistrer un paiement"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Command="{Binding NavigateToPaiementsCommand}" />

                    <Separator Margin="0,20" />

                    <TextBlock Text="Statistiques classes" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#34495E"
                               Margin="0,0,0,10" />
                    <TextBlock>
                        <Run Text="Nombre de classes: " Foreground="#7F8C8D" />
                        <Run Text="{Binding TotalClasses}" FontWeight="SemiBold" Foreground="#2C3E50" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Indicateur de chargement -->
        <Border Grid.RowSpan="3" 
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                <TextBlock Text="Chargement..." 
                           Foreground="White" 
                           FontSize="14"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
