<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.10" />
    
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.0.0" />
    
    <!-- Authentication JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    
    <!-- CORS -->
    <PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.2.0" />
    
    <!-- EF Core Tools (pour migrations depuis API) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <!-- Serilog pour logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    
    <!-- FluentValidation ASP.NET -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    
    <!-- Versioning API -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.0.0" />

  </ItemGroup>

  <ItemGroup>
    <!-- Dépendances vers autres projets -->
    <ProjectReference Include="..\SchoolFlow.Application\SchoolFlow.Application.csproj" />
    <ProjectReference Include="..\SchoolFlow.Infrastructure\SchoolFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\SchoolFlow.Domain\SchoolFlow.Domain.csproj" />
  </ItemGroup>

</Project>
